<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tirgum · Official letters explained in your language</title>
  <link rel="icon" href="/images/tirgum-icon.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=Noto+Sans+Ethiopic:wght@400;500&display=swap" rel="stylesheet">


  <link rel="stylesheet" href="/css/style.css">
</head>


<body class="bg-[#F2F8F7] text-[#0B4F4A] font-['Inter_Tight','Noto_Sans_Ethiopic',sans-serif]">
      <header class="flex items-center justify-around gap-5 p-2.5 bg-white border-b border-[#e6e6e6]">
    <a href="">
      <img src="/images/tirgum-logo.svg" alt="Tirgum" class="h-11 w-auto">
    </a>
        <nav>
            <div class="flex gap-2">
                <button>EN</button>
                <button>አማርኛ</button>
                <button>ES</button>
            </div>
        </nav>
    </header>

    <main class="max-w-5xl mx-auto px-6 pb-16">

      <a class="inline-flex items-center gap-2 mt-6 text-sm text-[#0B4F4A] no-underline hover:underline" href="/dashboard">
        <span aria-hidden="true">&larr;</span> Back to my letters
      </a>

     
      <div id="view-upload">
        <section class="mt-6">
          <h1 class="text-[28px] md:text-5xl leading-tight tracking-[-0.03em] text-[#0B4F4A] font-medium">Upload your <em>letter</em></h1>
          <p class="mt-3 text-sm text-[#5A716E]">Take a photo or upload a file. We'll explain it in your language.</p>
        </section>

        <form id="upload-form" novalidate>
          <section class="mt-8 grid gap-5 md:grid-cols-[1fr_340px] items-start">

            <div>
              <!-- Drop zone -->
              <div id="dropzone" class="bg-[#f2f8f6] border border-dashed border-[#9CC7C0] rounded-3xl p-8 flex flex-col items-center text-center">
                <div class="w-[70px] h-[70px] rounded-full bg-[#E6F2F0] flex items-center justify-center">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B4F4A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4"/><path d="m7 9 5-5 5 5"/><path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>
                </div>
                <p id="dropzone-title" class="mt-5 text-lg font-medium text-[#0B4F4A]">Drag your letter here</p>
                <p id="dropzone-file" class="hidden mt-1 text-sm text-[#5A716E] break-all"></p>

                <div class="my-4 flex items-center gap-3 w-full max-w-[305px] text-sm text-[#5A716E]">
                  <span class="h-px flex-1 bg-[#DCE5E3]"></span>or<span class="h-px flex-1 bg-[#DCE5E3]"></span>
                </div>

                <div class="flex flex-col sm:flex-row justify-center gap-2">
                  <button type="button" id="btn-photo" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#0B4F4A] text-white font-medium hover:bg-[#0D5F59]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                    Take a photo
                  </button>
                  <button type="button" id="btn-file" class="inline-block px-6 py-3 rounded-full bg-white border border-[#0F766E] text-[#0F766E] font-medium hover:bg-[#E6F2F0]">Choose a file</button>
                </div>

                <span class="block mt-4 text-xs text-[#5A716E]">JPG, PNG, or PDF · up to 10 MB</span>

                <!-- hidden inputs: the real file pickers -->
                <input type="file" id="input-file" accept="image/jpeg,image/png,application/pdf,.jpg,.jpeg,.png,.pdf" class="hidden">
                <input type="file" id="input-photo" accept="image/*" capture="environment" class="hidden">
              </div>

              <p class="mt-3 flex items-center gap-2 text-sm text-[#5A716E]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0B4F4A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                <span><strong class="text-[#0B4F4A]">We don't keep your photo or file.</strong> Only the explanation is saved.</span>
              </p>

              <p id="upload-error" role="alert" class="hidden mt-4 text-sm text-[#B42318]"></p>

              <!-- Language -->
              <div class="mt-8">
                <p class="text-sm font-medium">Explain it in</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <label class="cursor-pointer">
                    <input type="radio" name="lang" value="en" checked class="peer sr-only">
                    <span class="inline-block px-5 py-3 rounded-full border border-[#DCE5E3] bg-white font-medium peer-checked:bg-[#E6F2F0] peer-checked:border-[#0F766E] peer-focus-visible:ring-2 peer-focus-visible:ring-[#0F766E]">English</span>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="lang" value="am" class="peer sr-only">
                    <span class="inline-block px-5 py-3 rounded-full border border-[#DCE5E3] bg-white font-medium peer-checked:bg-[#E6F2F0] peer-checked:border-[#0F766E] peer-focus-visible:ring-2 peer-focus-visible:ring-[#0F766E]">አማርኛ</span>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="lang" value="es" class="peer sr-only">
                    <span class="inline-block px-5 py-3 rounded-full border border-[#DCE5E3] bg-white font-medium peer-checked:bg-[#E6F2F0] peer-checked:border-[#0F766E] peer-focus-visible:ring-2 peer-focus-visible:ring-[#0F766E]">Español</span>
                  </label>
                </div>
              </div>

              <div class="mt-8 flex items-center gap-4">
                <button type="submit" id="btn-explain" disabled
                  class="bg-[#F2A541] text-[#0B4F4A] font-medium px-6 py-3 rounded-full disabled:opacity-50 disabled:cursor-not-allowed">Explain my letter &rarr;</button>
                <span id="explain-hint" class="text-sm text-[#5A716E]">Add a photo or file first</span>
              </div>
            </div>

            <!-- For Best Result section -->
            <div class="bg-[#FFF8F7] border border-[#F3CFCB] rounded-3xl p-6">
              <span class="block text-sm font-medium text-[#B42318]">For best results</span>
              <section class="mt-3 flex flex-col gap-3">
                <div class="flex items-center gap-3">
                  <div class="bg-[#E6F2F0] w-[40px] h-[40px] rounded-full flex items-center justify-center shrink-0"><img src="/images/flatSurfaceIcon.png" alt="" class="w-[20px] h-[20px]"></div>
                  <p>Lay the letter on a flat surface</p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-[#E6F2F0] w-[40px] h-[40px] rounded-full flex items-center justify-center shrink-0"><img src="/images/lightIcon.png" alt="" class="w-[20px] h-[20px]"></div>
                  <p>Use good light, without shadows</p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-[#E6F2F0] w-[40px] h-[40px] rounded-full flex items-center justify-center shrink-0"><img src="/images/layerIcon.png" alt="" class="w-[20px] h-[20px]"></div>
                  <p>Add every page of the letter</p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-[#E6F2F0] w-[40px] h-[40px] rounded-full flex items-center justify-center shrink-0"><img src="/images/frameIcon.png" alt="" class="w-[20px] h-[20px]"></div>
                  <p>Fit the whole page in the frame</p>
                </div>
              </section>
            </div>
          </section>
        </form>
      </div>

      <!-- ================= VIEW 2: PROCESSING ================= -->
      <div id="view-processing" class="hidden mt-16 flex-col items-center text-center" aria-live="polite">
        <div class="w-[170px] h-[170px] rounded-full bg-[#E6F2F0] flex items-center justify-center">
          <img src="/images/tirgum-icon.svg" alt="" class="w-[100px] h-[100px]">
        </div>
        <h2 class="mt-8 text-4xl md:text-5xl tracking-[-0.03em] font-medium">Reading your <em>letter...</em></h2>

        <ol class="mt-8 w-full max-w-[435px] bg-white border border-[#DCE5E3] rounded-3xl p-5 text-left flex flex-col gap-4">
          <li class="proc-step flex items-center gap-3"><span class="proc-dot w-[34px] h-[34px] rounded-full border-2 border-[#DCE5E3] flex items-center justify-center text-white text-sm"></span><span class="proc-label">Reading your letter</span></li>
          <li class="proc-step flex items-center gap-3"><span class="proc-dot w-[34px] h-[34px] rounded-full border-2 border-[#DCE5E3] flex items-center justify-center text-white text-sm"></span><span class="proc-label">Understanding what it means</span></li>
          <li class="proc-step flex items-center gap-3"><span class="proc-dot w-[34px] h-[34px] rounded-full border-2 border-[#DCE5E3] flex items-center justify-center text-white text-sm"></span><span class="proc-label">Preparing your next steps</span></li>
        </ol>

        <p class="mt-5 max-w-[435px] text-sm text-[#5A716E]">This usually takes about 20 seconds. We don't keep your photo or file.</p>
        <button type="button" id="btn-cancel" class="mt-6 text-[#0F766E] font-medium hover:underline">Cancel</button>
      </div>

      <!-- ================= VIEW 3: ERROR ================= -->
      <div id="view-error" class="hidden mt-16 flex-col items-center text-center" role="alert">
        <div class="w-[120px] h-[120px] rounded-full bg-[#FFF8F7] border border-[#F3CFCB] flex items-center justify-center">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#B42318" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6"/><circle cx="12" cy="16.5" r=".6" fill="#B42318"/></svg>
        </div>
        <h2 id="error-title" class="mt-8 text-3xl md:text-4xl tracking-[-0.03em] font-medium">We couldn't read this letter</h2>
        <p id="error-text" class="mt-3 max-w-[435px] text-[#5A716E]"></p>
        <div class="mt-8 flex flex-col sm:flex-row gap-2">
          <button type="button" id="btn-retry" class="px-6 py-3 rounded-full bg-[#0B4F4A] text-white font-medium hover:bg-[#0D5F59]">Try again</button>
          <a href="/dashboard" class="px-6 py-3 rounded-full bg-white border border-[#0F766E] text-[#0F766E] font-medium">Back to my letters</a>
        </div>
      </div>

    </main>


</body>
</html>
