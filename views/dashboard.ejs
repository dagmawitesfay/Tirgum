<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=Noto+Sans+Ethiopic:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<!-- Helper-Function -->
<%
// Format Date in Oct 26 format
const formatDate = (date) => new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric"
});
// Deadline is calculated by difference between the deadline and todays date
 const daysLeft = (date) =>
    Math.ceil((new Date(date) - new Date()) / (1000 * 60 * 60 * 24));
%>
<body class="bg-[#f7faf9] text-[#0B4F4A]">
    <header class="flex items-center justify-around gap-5 p-2.5 bg-white border-b border-[#e6e6e6]">
    <a href="/">
      <img src="/images/tirgum-logo.svg" alt="Tirgum" class="h-11 w-auto">
    </a>
        <nav>
            <div class="flex gap-2">
                <button>EN</button>
                <button>አማርኛ</button>
                <button>ES</button>
            </div>
        </nav>
    </header>

    <main class="max-w-5xl mx-auto p-10">
        <!-- Good Afternnon Section -->
        <section class="flex justify-between items-center">
            <div>
                <h1 class="text-[28px] md:text-5xl leading-tight tracking-[-0.03em] text-[#0B4F4A] font-medium">Good Afternoon, <em class="font-['Instrument_Serif',Georgia,serif] italic font-normal"> Dagi</em></h1>
                <span class="mt-3">You have <%= urgentCount %> urgent letter</span>
            </div>

            <button class="inline-block px-6 py-3 rounded-full bg-[#F2A541] text-[#0B4F4A] font-medium no-underline hover:brightness-95"> Upload a letter
            </button>
        </section>

        <!-- COMING UP Section -->
        <section class="mt-10">
            <h2 class="text-2xl mb-4">Coming up</h2>
            <div class="flex gap-6">
                <!-- Iterate through each coming up documents and create a box -->
                <% comingUp.forEach((coming) => { %>
                    <div class="bg-[#f9fcfb] p-5 rounded-2xl border border-[#cbdad6]">
                        <!-- Date and Urgency container -->
                        <div class="flex justify-between">
                            <span><%= formatDate(coming.deadline) %></span>
                            <!-- Logic for the generating pill for urgency -->
                            <% if (coming.urgency === "urgent") { %>
                                <span class="px-3 py-1 rounded-full bg-[#ffedec] text-[#89202b]">Urgent</span>
                            <% } else if (coming.urgency === "soon") { %>
                                <span class="px-3 py-1 rounded-full bg-[#fef0dc] text-[#8a5a12]">Soon</span>
                            <% } else { %>
                                <span class="px-3 py-1 rounded-full bg-[#e6f2f0] text-[#0B4F4A]">No rush</span>
                            <% } %>
                        </div>
                        <p><span class="text-red-600 font-bold"><%= daysLeft(coming.deadline) %> days left</span></p>
                        <h3 class="mt-3 font-semibold"><%= coming.title %></h3>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- My Letter Section -->
        <section class="mt-10">
            <h2 class="text-2xl mb-2">My Letters (<%= letters.length %>)</h2>
            <div class="flex flex-wrap gap-6">
                <% letters.forEach((letter) => { %>
                    <a href="/letters/<%= letter._id %>">
                    <div class="bg-[#f9fcfb] p-5 rounded-2xl border border-[#cbdad6]" >
                        <% if (letter.urgency === "urgent") { %>
                            <span class="px-3 py-1 rounded-full bg-[#ffedec] text-[#89202b]">Urgent</span>
                        <% } else if (letter.urgency === "soon") { %>
                            <span class="px-3 py-1 rounded-full bg-[#fef0dc] text-[#8a5a12]">Soon</span>
                        <% } else { %>
                            <span class="px-3 py-1 rounded-full bg-[#e6f2f0] text-[#0B4F4A]">No rush</span>
                        <% } %>

                        <h3 class="text-xl font-semibold mt-2"><%= letter.title %></h3>
                        <p class="text-sm text-gray-400"><%= letter.sender %>, Uploaded <%= formatDate(letter.createdAt) %></p>
                        <div class="flex gap-2 mt-3">
                            <span class="px-3 py-1 rounded-full border capitalize"><%= letter.category %></span>
                            <!-- Letters have deadline, deadlineNote and no deadline -->
                            <% if (letter.deadline) { %>
                                <span class="whitespace-nowrap">Due <%= formatDate(letter.deadline) %></span>
                            <% } else if (letter.deadlineNote) { %>
                                <span><%= letter.deadlineNote %></span>
                            <% } else { %>
                                <span>No deadline</span>
                            <% } %>
                        </div>
                    </div>
                     </a>
                <% }); %>
            </div>
        </section>
    </main>
</body>
</html>
